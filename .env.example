# Supabase environment variables
# Copy this file to .env.local and fill in your real values.

# Public URL of your Supabase project (used by client + server)
NEXT_PUBLIC_SUPABASE_URL=https://yixdxumvpwqbykefbxif.supabase.com

# Anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_6YYRoMhGsJs8HSMeLFZYSA_rPEfFGq4

# Service role key — SERVER ONLY, never expose to the browser
# Used by src/lib/supabase/server.ts to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=sb_secret_EM9KzrY4lIssZFVU0zdrOA_1mzNelfS

# Optional: site URL used for redirects (e.g. signout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000